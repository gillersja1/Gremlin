{
  "name": "gremlin-pw",
  "version": "0.1.0",
  "description": "Turn a gremlin loose on your web app: it explores with Playwright, finds bugs and security warning signs, and hands you a test to reproduce each one.",
  "type": "module",
  "bin": {
    "gremlin": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gremlin": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "playwright",
    "monkey-testing",
    "exploratory-testing",
    "fuzzing",
    "security",
    "qa"
  ],
  "license": "MIT",
  "repository": "github:gillersja1/Gremlin",
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
